# OR-Path Multi-Agent / Graph-OR Agent
# Copy to .env and fill real values. Never commit .env

# === Cloud APIs ===
# MinerU Cloud — PDF/公式预处理  https://mineru.net → API管理
MINERU_API_TOKEN=

# 硅基流动 — bge-m3 embedding  https://cloud.siliconflow.cn → API密钥
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Cognee Cloud — 长期记忆  https://platform.cognee.ai
COGNEE_API_KEY=
COGNEE_BASE_URL=

# 讯飞星辰 MaaS — 对话与深度思考模型  https://maas.xfyun.cn
XFYUN_API_KEY=
XFYUN_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_MODEL=spark-x2.6

# DeepSeek — 对话与推理模型  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 本地 Embedding 模型路径 (Zero-Cloud 本地向量推理)
LOCAL_BGE_M3_PATH=/home/lanzao/antigravity/jolly-hawking/models/bge_m3_onnx
ORPATH_EMBED_LOCAL=1

# === OR-Path product defaults ===
# OCR: auto chooses text/pdf/image. Image stack uses user's ppocr install then rapidocr.
# ORPATH_PADDLEOCR_PYTHON=C:\Users\Lanzao\AppData\Local\Programs\Python\Python311\python.exe
# ORPATH_OCR_BACKEND=  (optional force: manual_stub|pdf_text|paddleocr|rapidocr)
# PADDLEOCR_ACCESS_TOKEN=  (optional cloud api via paddleocr cli)
# ORPATH_OCR_TIMEOUT=180

# === LightRAG (local framework; models via cloud) ===
LIGHTRAG_EMBEDDING_PROVIDER=openai_compatible
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3
LIGHTRAG_LLM_PROVIDER=openai_compatible
LIGHTRAG_LLM_MODEL=deepseek-chat
