# OR-Path Multi-Agent / Graph-OR Agent
# Copy to .env and fill real values. Never commit .env

# === Cloud APIs ===
# MinerU Cloud — PDF/公式预处理  https://mineru.net → API管理
MINERU_API_TOKEN=

# 硅基流动 — bge-m3 embedding  https://cloud.siliconflow.cn → API密钥
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Cognee Cloud — 长期记忆  https://platform.cognee.ai
COGNEE_API_KEY=
COGNEE_BASE_URL=

# DeepSeek — Pi / OpenPi 唯一对话模型  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# === OR-Path product defaults ===
# Live multi-agent (pi-subagents). Product default ON. CI/gates force 0.
# Set 0 for cheap deterministic runs without Pi spawn.
ORPATH_LIVE_SUBAGENT=1

# === Pi runtime pins (informational) ===
PI_NPM_VERSION=@earendil-works/pi-coding-agent@0.82.1
PI_SUBAGENT_VERSION=pi-subagents@0.37.2

# === LightRAG (local framework; models via cloud) ===
LIGHTRAG_EMBEDDING_PROVIDER=openai_compatible
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3
LIGHTRAG_LLM_PROVIDER=openai_compatible
LIGHTRAG_LLM_MODEL=deepseek-chat
