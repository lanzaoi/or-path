# OR-Path — .gitignore

# Python
.venv-314/
__pycache__/
*.pyc
*.egg-info/
dist/
.pytest_cache/

# Secrets
.env
backend.env
*.env.local

# Local data / indexes
data/
lightrag_data/
chroma_db/
*.db
*.db-shm
*.db-wal
knowledge/mineru_out/
knowledge/lightrag_ws/
knowledge/bm25/
knowledge/fts/
knowledge/corpus/*.pdf
knowledge/chunks/*.jsonl
!knowledge/chunks/.gitkeep
# process memory local drafts (seeds under knowledge/lessons are tracked)
memory/lessons/
!knowledge/lessons/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
nul

# Docker
docker-compose.override.yml

# Models
models/
mineru_models/

# Upstream mirrors / heavy trees
vendor/
pi-main/
# openpi removed 2026-07-31; keep ignore
openpi/
runtime/node_modules/
**/node_modules/

# Runtime artifacts — install/workdir ROOT only
# (must not swallow demo/seed/**/{outputs,notes,papers,runs})
/outputs/
/notes/
/papers/
/runs/

# Pi local runtime caches (keep .pi/agents + settings tracked)
.pi/npm/
.pi/memory/
.pi/orpath_model.json
.pi-subagents/

# Screenshots default-ignore (allow listed evidence)
*.png
!docs/archive/evidence/t2-live-evidence-board.png

# Contest bulk / local case drops — NEVER publish
fixtures/t3/tube_cut_b2026/raw/
inbox/**
!inbox/README.md

# Hermes IDE workspace — local only (plans live in docs/archive/plans/)
.hermes/

# Optional local visual lab — keep demo/seed for L1/L2 default face
demo/*
!demo/seed/
!demo/seed/**

# pulled npm modules
third_party/**/node_modules/
