# OR-Path — .gitignore

# Python
.venv-314/
__pycache__/
*.pyc
*.egg-info/
dist/
.pytest_cache/

# Secrets
.env
backend.env
*.env.local

# Local data / indexes
data/
experiments/
lightrag_data/
chroma_db/
*.db
*.db-shm
*.db-wal
knowledge/mineru_out/
knowledge/lightrag_ws/
knowledge/bm25/
knowledge/fts/
knowledge/corpus/*.pdf
knowledge/chunks/*.jsonl
knowledge/chunks/*.json
!knowledge/chunks/.gitkeep
knowledge/inbox_pdf/*.pdf
knowledge/inbox_pdf/fixture_*
!knowledge/inbox_pdf/README.md
# process memory local drafts (seeds under knowledge/lessons are tracked)
memory/lessons/
!knowledge/lessons/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
nul

# Docker
docker-compose.override.yml

# Models
models/
mineru_models/

# Upstream mirrors / heavy trees
vendor/
pi-main/
openpi/
runtime/
**/node_modules/

# Runtime artifacts — install/workdir ROOT only
# (must not swallow demo/seed/**/{outputs,notes,papers,runs})
/outputs/
/notes/
/papers/
/runs/

# Legacy retired directories (if present locally)
.pi/
.pi-subagents/

# Screenshots default-ignore (allow listed evidence)
*.png
!docs/archive/evidence/t2-live-evidence-board.png

# Contest bulk / local case drops — NEVER publish
fixtures/t3/tube_cut_b2026/raw/
inbox/**
!inbox/README.md

# Hermes IDE workspace — local only (plans live in docs/archive/plans/)
.hermes/
.agent/
.refactor_backup/
*_raw.txt

# Optional local visual lab — keep demo/seed for L1/L2 default face
demo/*
!demo/seed/
!demo/seed/**

# pulled npm modules
third_party/**/node_modules/

# eval bench caches
eval_or_bench/__pycache__/
eval_or_bench/**/__pycache__/
eval_or_bench/__pycache__/
