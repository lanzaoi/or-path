{
  "packages": [
    "npm:pi-subagents@0.37.2",
    "npm:@samfp/pi-memory"
  ],
  "subagents": {
    "defaultModel": "deepseek-v4-flash"
  },
  "memory": {
    "enabled": true,
    "localPath": ".pi/memory",
    "notes": "prefs/lessons only — never authoritative objective/tour/routes (specs/memory.md)"
  },
  "orpath": {
    "liveSubagentDefault": true,
    "appendSystem": ".pi/APPEND_SYSTEM.md",
    "controlPlane": "orpath.bat menu | run-full | intake",
    "ocr": "tools/intake_ocr.py (paddle/ppocr → api → rapidocr)",
    "piDefaultModel": "deepseek-v4-flash",
    "piDefaultProvider": "deepseek"
  }
}
