{
  "schema": "orpath.inventory_collaboration.v1",
  "problem_id": "wagner_whitin_clsp",
  "numeric_authority": "local_solver_and_independent_validator",
  "selection_rule": "lexicographic_not_agent_vote",
  "objective_order": [
    "hard_constraints",
    "total_cost",
    "total_setup_cost",
    "max_inventory_level"
  ],
  "budget_scope": "discretionary_experiment_effort_excluding_baseline_and_gates",
  "budget_percent": {
    "auditor": 20,
    "exact_bound": 15,
    "heuristic": 35,
    "realities": 30
  },
  "roles": {
    "or-inventory-lead": {
      "owns": [
        "assumption_register",
        "experiment_registry",
        "budget_ledger"
      ],
      "forbidden": [
        "invent_objective",
        "override_validator",
        "agent_vote"
      ]
    },
    "or-inventory-auditor": {
      "owns": [
        "input_manifest",
        "demand_nonnegativity",
        "cost_parameters_consistency",
        "capacity_bounds",
        "demand_series_hash"
      ],
      "forbidden": [
        "author_solution_numbers",
        "claim_optimality"
      ]
    },
    "or-inventory-exact-bound": {
      "owns": [
        "exact_lower_bound",
        "wagner_whitin_dp_bound",
        "mip_relaxation_gap",
        "bound_evidence"
      ],
      "forbidden": [
        "modify_demand_vector",
        "claim_unproved_optimum"
      ]
    },
    "or-inventory-heuristic": {
      "owns": [
        "silver_meal_incumbent",
        "part_period_balancing_incumbent",
        "lot_schedule_plan"
      ],
      "forbidden": [
        "violate_flow_balance",
        "forge_optimal_status",
        "claim_heuristic_global_optimum"
      ]
    },
    "or-inventory-realities": {
      "owns": [
        "safety_stock_policy",
        "lead_time_replenishment",
        "storage_capacity_ceiling",
        "rolling_horizon_plan",
        "reality_feasibility"
      ],
      "forbidden": [
        "ignore_stockout",
        "drop_safety_stock",
        "claim_unvalidated_feasibility"
      ]
    },
    "or-inventory-redteam": {
      "owns": [
        "independent_recompute",
        "tamper_tests",
        "claim_audit"
      ],
      "forbidden": [
        "repair_candidate",
        "share_solver_state",
        "waive_failed_gate"
      ]
    }
  },
  "handoff_order": [
    "assumptions",
    "audit",
    "exact_bound",
    "heuristic_search",
    "realities",
    "redteam_validate",
    "write"
  ],
  "experiment_rules": {
    "changed_factors_per_card": 1,
    "seed_required_for_stochastic_search": true,
    "baseline_artifact_required": true,
    "acceptance_criteria_required_before_run": true,
    "failed_experiments_are_retained": true,
    "numbers_may_only_move_via_json_artifacts": true,
    "hard_runtime_cap_required": true,
    "timeout_is_not_no_solution": true,
    "accepted_candidate_requires_independent_validation": true,
    "official_candidate_must_be_lexicographically_nonworse": true,
    "heuristic_status_must_be_feasible": true,
    "forged_optimality_is_forbidden": true
  },
  "candidate_lifecycle": [
    "PROPOSED",
    "SOLVER_FEASIBLE",
    "INDEPENDENTLY_VALIDATED",
    "REDTEAM_PASSED",
    "ACCEPTED"
  ],
  "registry": {
    "experiment_cards": "experiments/inventory/cards",
    "budget_ledger": "experiments/inventory/budget-ledger.json",
    "accepted_solution": "outputs/wagner_whitin_clsp-solution.json",
    "validation_report": "outputs/wagner_whitin_clsp-validate.json",
    "redteam_report": "outputs/wagner_whitin_clsp-redteam.json"
  },
  "stop_rules": {
    "auditor": [
      "freeze_input_manifest_hash_before_search",
      "fail_on_negative_or_missing_demand",
      "fail_on_negative_cost_parameter",
      "fail_on_negative_capacity",
      "require_demand_series_consistency_before_search"
    ],
    "exact_bound": [
      "report_wagner_whitin_dp_or_mip_lower_bound_with_gap",
      "cite_ww12_known_optimum_when_available",
      "stop_after_time_limit_without_improvement",
      "never_report_a_bound_without_solver_evidence"
    ],
    "heuristic": [
      "stop_after_two_budget_levels_and_three_new_seeds_do_not_improve_total_cost",
      "retain_best_feasible_incumbent_within_hard_constraints",
      "never_report_optimal_status_for_heuristic"
    ],
    "realities": [
      "stop_after_safety_stock_and_capacity_feasibility_converge",
      "report_unmet_realities_explicitly",
      "never_drop_a_safety_stock_constraint_to_restore_feasibility"
    ]
  },
  "tamper_tests": [
    "flow_balance_violation_injection",
    "setup_evasion_tamper",
    "capacity_overflow_injection",
    "safety_stock_deficit_tamper",
    "cost_deflation_forgery"
  ]
}
