{
  "schema": "orpath.microgrid_collaboration.v1",
  "problem_id": "microgrid_dispatch",
  "numeric_authority": "local_solver_and_independent_validator",
  "selection_rule": "lexicographic_not_agent_vote",
  "objective_order": [
    "hard_constraints",
    "total_purchase_cost",
    "peak_demand_kw",
    "battery_degradation_loss"
  ],
  "budget_scope": "discretionary_experiment_effort_excluding_baseline_and_gates",
  "budget_percent": {
    "auditor": 20,
    "exact_bound": 15,
    "heuristic": 35,
    "realities": 30
  },
  "roles": {
    "or-microgrid-lead": {
      "owns": [
        "assumption_register",
        "experiment_registry",
        "budget_ledger"
      ],
      "forbidden": [
        "invent_objective",
        "override_validator",
        "agent_vote"
      ]
    },
    "or-microgrid-auditor": {
      "owns": [
        "input_manifest",
        "tou_tariff_integrity",
        "pv_load_profile_consistency",
        "battery_nameplate_specs",
        "weather_solar_hash"
      ],
      "forbidden": [
        "author_solution_numbers",
        "claim_optimality"
      ]
    },
    "or-microgrid-exact-bound": {
      "owns": [
        "exact_lower_bound",
        "day_ahead_lp_dual_bound",
        "shadow_prices",
        "bound_evidence"
      ],
      "forbidden": [
        "alter_load_demand",
        "claim_unproved_optimum"
      ]
    },
    "or-microgrid-heuristic": {
      "owns": [
        "peak_shaving_rule_incumbent",
        "mpc_rolling_incumbent",
        "battery_dispatch_plan"
      ],
      "forbidden": [
        "violate_power_balance",
        "forge_optimal_status",
        "claim_heuristic_global_optimum"
      ]
    },
    "or-microgrid-realities": {
      "owns": [
        "battery_degradation_policy",
        "demand_charge_threshold_policy",
        "ev_uncoordinated_charging_plan",
        "reality_feasibility"
      ],
      "forbidden": [
        "exceed_soc_limits",
        "hide_emergency_purchase",
        "claim_unvalidated_feasibility"
      ]
    },
    "or-microgrid-redteam": {
      "owns": [
        "independent_recompute",
        "tamper_tests",
        "claim_audit"
      ],
      "forbidden": [
        "repair_candidate",
        "share_solver_state",
        "waive_failed_gate"
      ]
    }
  },
  "handoff_order": [
    "assumptions",
    "audit",
    "exact_bound",
    "heuristic_search",
    "realities",
    "redteam_validate",
    "write"
  ],
  "experiment_rules": {
    "changed_factors_per_card": 1,
    "seed_required_for_stochastic_search": true,
    "baseline_artifact_required": true,
    "acceptance_criteria_required_before_run": true,
    "failed_experiments_are_retained": true,
    "numbers_may_only_move_via_json_artifacts": true,
    "hard_runtime_cap_required": true,
    "timeout_is_not_no_solution": true,
    "accepted_candidate_requires_independent_validation": true,
    "official_candidate_must_be_lexicographically_nonworse": true,
    "heuristic_status_must_be_feasible": true,
    "forged_optimality_is_forbidden": true
  },
  "candidate_lifecycle": [
    "PROPOSED",
    "SOLVER_FEASIBLE",
    "INDEPENDENTLY_VALIDATED",
    "REDTEAM_PASSED",
    "ACCEPTED"
  ],
  "registry": {
    "experiment_cards": "experiments/microgrid/cards",
    "budget_ledger": "experiments/microgrid/budget-ledger.json",
    "accepted_solution": "outputs/microgrid_dispatch-solution.json",
    "validation_report": "outputs/microgrid_dispatch-validate.json",
    "redteam_report": "outputs/microgrid_dispatch-redteam.json"
  },
  "stop_rules": {
    "auditor": [
      "freeze_tou_tariff_and_solar_hash_before_search",
      "fail_on_negative_or_missing_load_demand",
      "fail_on_battery_nameplate_inconsistency",
      "fail_on_pv_load_profile_mismatch",
      "require_input_manifest_hash_consistency_before_search"
    ],
    "exact_bound": [
      "report_day_ahead_lp_dual_lower_bound_with_gap",
      "cite_glop_optimality_proof_when_available",
      "stop_after_time_limit_without_improvement",
      "never_report_a_bound_without_solver_evidence"
    ],
    "heuristic": [
      "stop_after_two_budget_levels_and_three_new_seeds_do_not_improve_total_purchase_cost",
      "retain_best_feasible_incumbent_within_hard_constraints",
      "never_report_optimal_status_for_heuristic"
    ],
    "realities": [
      "stop_after_battery_degradation_and_demand_charge_policies_converge",
      "report_unmet_realities_explicitly",
      "never_drop_a_soc_limit_to_restore_feasibility"
    ]
  },
  "tamper_tests": [
    "power_balance_violation_injection",
    "soc_limit_breach_injection",
    "battery_efficiency_dynamics_tamper",
    "daily_storage_imbalance_tamper",
    "energy_cost_deflation_forgery"
  ]
}
