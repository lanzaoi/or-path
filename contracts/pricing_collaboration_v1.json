{
  "schema": "orpath.pricing_collaboration.v1",
  "problem_id": "farmer_stochastic_lp",
  "numeric_authority": "local_solver_and_independent_validator",
  "selection_rule": "lexicographic_not_agent_vote",
  "objective_order": [
    "hard_constraints",
    "expected_profit",
    "risk_cvar_penalty",
    "evpi_efficiency"
  ],
  "budget_scope": "discretionary_experiment_effort_excluding_baseline_and_gates",
  "budget_percent": {
    "auditor": 20,
    "exact_bound": 15,
    "heuristic": 35,
    "realities": 30
  },
  "roles": {
    "or-pricing-lead": {
      "owns": [
        "assumption_register",
        "experiment_registry",
        "budget_ledger"
      ],
      "forbidden": [
        "invent_objective",
        "override_validator",
        "agent_vote"
      ]
    },
    "or-pricing-auditor": {
      "owns": [
        "input_manifest",
        "scenario_probability_simplex",
        "yield_distribution_integrity",
        "price_matrix_consistency",
        "scenario_tree_hash"
      ],
      "forbidden": [
        "author_solution_numbers",
        "claim_optimality"
      ]
    },
    "or-pricing-exact-bound": {
      "owns": [
        "exact_lower_bound",
        "l_shaped_benders_cut",
        "deterministic_equivalent_lp_bound",
        "bound_evidence"
      ],
      "forbidden": [
        "change_scenario_probabilities",
        "claim_unproved_optimum"
      ]
    },
    "or-pricing-heuristic": {
      "owns": [
        "sample_average_approximation_incumbent",
        "bid_price_heuristic_incumbent",
        "allocation_pricing_plan"
      ],
      "forbidden": [
        "violate_first_stage_capacity",
        "forge_optimal_status",
        "claim_heuristic_global_optimum"
      ]
    },
    "or-pricing-realities": {
      "owns": [
        "cvar_risk_aversion_policy",
        "overbooking_cancellation_policy",
        "demand_elasticity_fencing_policy",
        "reality_feasibility"
      ],
      "forbidden": [
        "ignore_recourse_shortage",
        "hide_evpi_gap",
        "claim_unvalidated_feasibility"
      ]
    },
    "or-pricing-redteam": {
      "owns": [
        "independent_recompute",
        "tamper_tests",
        "claim_audit"
      ],
      "forbidden": [
        "repair_candidate",
        "share_solver_state",
        "waive_failed_gate"
      ]
    }
  },
  "handoff_order": [
    "assumptions",
    "audit",
    "exact_bound",
    "heuristic_search",
    "realities",
    "redteam_validate",
    "write"
  ],
  "experiment_rules": {
    "changed_factors_per_card": 1,
    "seed_required_for_stochastic_search": true,
    "baseline_artifact_required": true,
    "acceptance_criteria_required_before_run": true,
    "failed_experiments_are_retained": true,
    "numbers_may_only_move_via_json_artifacts": true,
    "hard_runtime_cap_required": true,
    "timeout_is_not_no_solution": true,
    "accepted_candidate_requires_independent_validation": true,
    "official_candidate_must_be_lexicographically_nonworse": true,
    "heuristic_status_must_be_feasible": true,
    "forged_optimality_is_forbidden": true
  },
  "candidate_lifecycle": [
    "PROPOSED",
    "SOLVER_FEASIBLE",
    "INDEPENDENTLY_VALIDATED",
    "REDTEAM_PASSED",
    "ACCEPTED"
  ],
  "registry": {
    "experiment_cards": "experiments/pricing/cards",
    "budget_ledger": "experiments/pricing/budget-ledger.json",
    "accepted_solution": "outputs/farmer_stochastic_lp-solution.json",
    "validation_report": "outputs/farmer_stochastic_lp-validate.json",
    "redteam_report": "outputs/farmer_stochastic_lp-redteam.json"
  },
  "stop_rules": {
    "auditor": [
      "freeze_scenario_probability_simplex_and_yield_hash_before_search",
      "fail_on_negative_or_missing_scenario_probability",
      "fail_on_probability_simplex_mismatch",
      "fail_on_yield_distribution_inconsistency",
      "require_input_manifest_hash_consistency_before_search"
    ],
    "exact_bound": [
      "report_deterministic_equivalent_lp_bound_with_gap",
      "cite_l_shaped_benders_evidence_when_available",
      "stop_after_time_limit_without_improvement",
      "never_report_a_bound_without_solver_evidence"
    ],
    "heuristic": [
      "stop_after_two_budget_levels_and_three_new_seeds_do_not_improve_expected_profit",
      "retain_best_feasible_incumbent_within_hard_constraints",
      "never_report_optimal_status_for_heuristic"
    ],
    "realities": [
      "stop_after_cvar_overbooking_and_fencing_policies_converge",
      "report_unmet_realities_explicitly",
      "never_drop_a_recourse_shortage_penalty_to_restore_feasibility"
    ]
  },
  "tamper_tests": [
    "first_stage_capacity_overflow",
    "scenario_recourse_balance_tamper",
    "stochastic_inequality_forgery",
    "expected_profit_inflation_forgery",
    "first_stage_cost_tamper"
  ]
}
