{
  "schema": "orpath.project_collaboration.v1",
  "problem_id": "psplib_rcpsp",
  "numeric_authority": "local_solver_and_independent_validator",
  "selection_rule": "lexicographic_not_agent_vote",
  "objective_order": [
    "hard_constraints",
    "makespan",
    "resource_peak_demand",
    "total_slack"
  ],
  "budget_scope": "discretionary_experiment_effort_excluding_baseline_and_gates",
  "budget_percent": {
    "auditor": 20,
    "exact_bound": 15,
    "heuristic": 35,
    "realities": 30
  },
  "roles": {
    "or-project-lead": {
      "owns": [
        "assumption_register",
        "experiment_registry",
        "budget_ledger"
      ],
      "forbidden": [
        "invent_objective",
        "override_validator",
        "agent_vote"
      ]
    },
    "or-project-auditor": {
      "owns": [
        "input_manifest",
        "network_dag_acyclicity",
        "activity_demand_nonnegativity",
        "resource_capacity_bounds",
        "activity_network_hash"
      ],
      "forbidden": [
        "author_solution_numbers",
        "claim_optimality"
      ]
    },
    "or-project-exact-bound": {
      "owns": [
        "exact_lower_bound",
        "cpm_critical_path_bound",
        "cp_sat_gap",
        "psplib_known_optimum",
        "bound_evidence"
      ],
      "forbidden": [
        "change_activity_duration",
        "claim_unproved_optimum"
      ]
    },
    "or-project-heuristic": {
      "owns": [
        "priority_rule_incumbent",
        "forward_backward_incumbent",
        "schedule_plan"
      ],
      "forbidden": [
        "change_precedence",
        "forge_optimal_status",
        "claim_heuristic_global_optimum"
      ]
    },
    "or-project-realities": {
      "owns": [
        "nonrenewable_resource_policy",
        "calendar_downtime_policy",
        "resource_leveling_plan",
        "reality_feasibility"
      ],
      "forbidden": [
        "drop_precedence_constraint",
        "hide_resource_overuse",
        "claim_unvalidated_feasibility"
      ]
    },
    "or-project-redteam": {
      "owns": [
        "independent_recompute",
        "tamper_tests",
        "claim_audit"
      ],
      "forbidden": [
        "repair_candidate",
        "share_solver_state",
        "waive_failed_gate"
      ]
    }
  },
  "handoff_order": [
    "assumptions",
    "audit",
    "exact_bound",
    "heuristic_search",
    "realities",
    "redteam_validate",
    "write"
  ],
  "experiment_rules": {
    "changed_factors_per_card": 1,
    "seed_required_for_stochastic_search": true,
    "baseline_artifact_required": true,
    "acceptance_criteria_required_before_run": true,
    "failed_experiments_are_retained": true,
    "numbers_may_only_move_via_json_artifacts": true,
    "hard_runtime_cap_required": true,
    "timeout_is_not_no_solution": true,
    "accepted_candidate_requires_independent_validation": true,
    "official_candidate_must_be_lexicographically_nonworse": true,
    "heuristic_status_must_be_feasible": true,
    "forged_optimality_is_forbidden": true
  },
  "candidate_lifecycle": [
    "PROPOSED",
    "SOLVER_FEASIBLE",
    "INDEPENDENTLY_VALIDATED",
    "REDTEAM_PASSED",
    "ACCEPTED"
  ],
  "registry": {
    "experiment_cards": "experiments/project/cards",
    "budget_ledger": "experiments/project/budget-ledger.json",
    "accepted_solution": "outputs/psplib_rcpsp-solution.json",
    "validation_report": "outputs/psplib_rcpsp-validate.json",
    "redteam_report": "outputs/psplib_rcpsp-redteam.json"
  },
  "stop_rules": {
    "auditor": [
      "freeze_input_manifest_hash_before_search",
      "fail_on_negative_or_missing_duration",
      "fail_on_negative_demand_or_capacity",
      "require_activity_network_acyclicity_before_search"
    ],
    "exact_bound": [
      "report_cp_sat_or_cpm_lower_bound_with_gap",
      "cite_psplib_known_optimum_when_available",
      "stop_after_time_limit_without_improvement",
      "never_report_a_bound_without_solver_evidence"
    ],
    "heuristic": [
      "stop_after_two_budget_levels_and_three_new_seeds_do_not_improve_makespan",
      "retain_best_feasible_incumbent_within_hard_constraints",
      "never_report_optimal_status_for_heuristic"
    ],
    "realities": [
      "stop_after_calendar_and_leveling_feasibility_converge",
      "report_unmet_realities_explicitly",
      "never_drop_a_precedence_constraint_to_restore_feasibility"
    ]
  },
  "tamper_tests": [
    "resource_capacity_overflow",
    "activity_precedence_inversion",
    "duration_inconsistency_cheat",
    "makespan_deflation",
    "activity_omission_tamper"
  ]
}
