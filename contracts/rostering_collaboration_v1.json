{
  "schema": "orpath.rostering_collaboration.v1",
  "problem_id": "staff_rostering",
  "numeric_authority": "local_solver_and_independent_validator",
  "selection_rule": "lexicographic_not_agent_vote",
  "objective_order": [
    "hard_constraints",
    "fairness_variance",
    "unpreferred_shift_count",
    "total_overtime_hours"
  ],
  "budget_scope": "discretionary_experiment_effort_excluding_baseline_and_gates",
  "budget_percent": {
    "auditor": 20,
    "exact_bound": 15,
    "heuristic": 35,
    "realities": 30
  },
  "roles": {
    "or-rostering-lead": {
      "owns": [
        "assumption_register",
        "experiment_registry",
        "budget_ledger"
      ],
      "forbidden": [
        "invent_objective",
        "override_validator",
        "agent_vote"
      ]
    },
    "or-rostering-auditor": {
      "owns": [
        "input_manifest",
        "shift_demand_matrix_integrity",
        "employee_contract_limits",
        "skill_qualification_matrix",
        "staff_profile_hash"
      ],
      "forbidden": [
        "author_solution_numbers",
        "claim_optimality"
      ]
    },
    "or-rostering-exact-bound": {
      "owns": [
        "exact_lower_bound",
        "cp_sat_relaxation_gap",
        "shift_covering_dual_bound",
        "bound_evidence"
      ],
      "forbidden": [
        "reduce_shift_demands",
        "claim_unproved_optimum"
      ]
    },
    "or-rostering-heuristic": {
      "owns": [
        "column_generation_incumbent",
        "simulated_annealing_incumbent",
        "roster_plan"
      ],
      "forbidden": [
        "violate_night_rest",
        "forge_optimal_status",
        "claim_heuristic_global_optimum"
      ]
    },
    "or-rostering-realities": {
      "owns": [
        "labor_law_mandatory_rest_policy",
        "weekend_rotation_fairness_policy",
        "overtime_ceiling_policy",
        "reality_feasibility"
      ],
      "forbidden": [
        "exceed_consecutive_days",
        "hide_understaffing",
        "claim_unvalidated_feasibility"
      ]
    },
    "or-rostering-redteam": {
      "owns": [
        "independent_recompute",
        "tamper_tests",
        "claim_audit"
      ],
      "forbidden": [
        "repair_candidate",
        "share_solver_state",
        "waive_failed_gate"
      ]
    }
  },
  "handoff_order": [
    "assumptions",
    "audit",
    "exact_bound",
    "heuristic_search",
    "realities",
    "redteam_validate",
    "write"
  ],
  "experiment_rules": {
    "changed_factors_per_card": 1,
    "seed_required_for_stochastic_search": true,
    "baseline_artifact_required": true,
    "acceptance_criteria_required_before_run": true,
    "failed_experiments_are_retained": true,
    "numbers_may_only_move_via_json_artifacts": true,
    "hard_runtime_cap_required": true,
    "timeout_is_not_no_solution": true,
    "accepted_candidate_requires_independent_validation": true,
    "official_candidate_must_be_lexicographically_nonworse": true,
    "heuristic_status_must_be_feasible": true,
    "forged_optimality_is_forbidden": true
  },
  "candidate_lifecycle": [
    "PROPOSED",
    "SOLVER_FEASIBLE",
    "INDEPENDENTLY_VALIDATED",
    "REDTEAM_PASSED",
    "ACCEPTED"
  ],
  "registry": {
    "experiment_cards": "experiments/rostering/cards",
    "budget_ledger": "experiments/rostering/budget-ledger.json",
    "accepted_solution": "outputs/staff_rostering-solution.json",
    "validation_report": "outputs/staff_rostering-validate.json",
    "redteam_report": "outputs/staff_rostering-redteam.json"
  },
  "stop_rules": {
    "auditor": [
      "freeze_shift_demand_matrix_hash_before_search",
      "fail_on_negative_or_missing_shift_demand",
      "fail_on_employee_contract_limit_violation",
      "fail_on_unqualified_skill_assignment",
      "require_staff_profile_hash_consistency_before_search"
    ],
    "exact_bound": [
      "report_cp_sat_relaxation_or_shift_covering_dual_lower_bound_with_gap",
      "cite_cp_sat_optimality_proof_when_available",
      "stop_after_time_limit_without_improvement",
      "never_report_a_bound_without_solver_evidence"
    ],
    "heuristic": [
      "stop_after_two_budget_levels_and_three_new_seeds_do_not_improve_fairness_variance",
      "retain_best_feasible_incumbent_within_hard_constraints",
      "never_report_optimal_status_for_heuristic"
    ],
    "realities": [
      "stop_after_labor_law_rest_and_weekend_rotation_policies_converge",
      "report_unmet_realities_explicitly",
      "never_drop_a_mandatory_rest_constraint_to_restore_feasibility"
    ]
  },
  "tamper_tests": [
    "understaffing_coverage_tamper",
    "shift_clash_tamper",
    "night_rest_violation_injection",
    "consecutive_workday_overflow",
    "fairness_metric_tamper"
  ]
}
