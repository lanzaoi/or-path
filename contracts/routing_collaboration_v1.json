{
  "schema": "orpath.routing_collaboration.v1",
  "problem_id": "pyvrp_vrptw",
  "numeric_authority": "local_solver_and_independent_validator",
  "selection_rule": "lexicographic_not_agent_vote",
  "objective_order": [
    "hard_constraints",
    "total_distance",
    "num_vehicles_used",
    "max_route_duration"
  ],
  "budget_scope": "discretionary_experiment_effort_excluding_baseline_and_gates",
  "budget_percent": {
    "auditor": 20,
    "exact_bound": 15,
    "hgs": 35,
    "realities": 30
  },
  "roles": {
    "or-vrp-lead": {
      "owns": ["assumption_register", "experiment_registry", "budget_ledger"],
      "forbidden": ["invent_objective", "override_validator", "agent_vote"]
    },
    "or-vrp-auditor": {
      "owns": ["input_manifest", "distance_matrix_symmetry", "time_window_consistency", "coordinate_integrity_hash"],
      "forbidden": ["author_solution_numbers", "claim_optimality"]
    },
    "or-vrp-exact-bound": {
      "owns": ["exact_lower_bound", "mip_gap", "bound_evidence"],
      "forbidden": ["change_demand", "claim_unproved_optimum"]
    },
    "or-vrp-hgs": {
      "owns": ["hgs_incumbent", "alns_incumbent", "route_plan"],
      "forbidden": ["change_time_windows", "forge_optimal_status", "claim_heuristic_global_optimum"]
    },
    "or-vrp-realities": {
      "owns": ["driver_hour_policy", "shift_window_policy", "rolling_horizon_plan", "reality_feasibility"],
      "forbidden": ["drop_legal_constraint", "hide_violation", "claim_unvalidated_feasibility"]
    },
    "or-vrp-redteam": {
      "owns": ["independent_recompute", "tamper_tests", "claim_audit"],
      "forbidden": ["repair_candidate", "share_solver_state", "waive_failed_gate"]
    }
  },
  "handoff_order": [
    "assumptions",
    "audit",
    "exact_bound",
    "hgs_search",
    "realities",
    "redteam_validate",
    "write"
  ],
  "experiment_rules": {
    "changed_factors_per_card": 1,
    "seed_required_for_stochastic_search": true,
    "baseline_artifact_required": true,
    "acceptance_criteria_required_before_run": true,
    "failed_experiments_are_retained": true,
    "numbers_may_only_move_via_json_artifacts": true,
    "hard_runtime_cap_required": true,
    "timeout_is_not_no_solution": true,
    "accepted_candidate_requires_independent_validation": true,
    "official_candidate_must_be_lexicographically_nonworse": true,
    "heuristic_status_must_be_feasible": true,
    "forged_optimality_is_forbidden": true
  },
  "candidate_lifecycle": [
    "PROPOSED",
    "SOLVER_FEASIBLE",
    "INDEPENDENTLY_VALIDATED",
    "REDTEAM_PASSED",
    "ACCEPTED"
  ],
  "registry": {
    "budget_ledger": "experiments/routing/budget-ledger.json",
    "accepted_solution": "outputs/pyvrp_vrptw-solution.json",
    "validation_report": "outputs/pyvrp_vrptw-validate.json",
    "redteam_report": "outputs/pyvrp_vrptw-redteam.json"
  },
  "stop_rules": {
    "auditor": [
      "verify_distance_matrix_symmetry_and_triangle_inequality",
      "fail_on_time_window_conflict",
      "freeze_input_hash_before_search"
    ],
    "exact_bound": [
      "report_mip_or_cp_sat_lower_bound_with_gap",
      "stop_after_time_limit_without_improvement",
      "never_report_a_bound_without_solver_evidence"
    ],
    "hgs": [
      "stop_after_two_budget_levels_and_three_new_seeds_do_not_improve_distance",
      "retain_best_feasible_incumbent_at_fixed_vehicle_count",
      "never_report_optimal_status_for_heuristic"
    ],
    "realities": [
      "stop_after_shift_window_and_driver_hour_feasibility_converge",
      "report_unmet_realities_explicitly",
      "never_drop_a_legal_constraint_to_restore_feasibility"
    ]
  },
  "tamper_tests": [
    "capacity_overflow_injection",
    "client_omission_tamper",
    "time_window_inversion",
    "distance_forgery",
    "coordinate_hash_tamper"
  ]
}
