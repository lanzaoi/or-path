{
  "schema": "orpath.scheduling_collaboration.v1",
  "problem_id": "pyjobshop_jssp",
  "numeric_authority": "local_solver_and_independent_validator",
  "selection_rule": "lexicographic_not_agent_vote",
  "objective_order": [
    "hard_constraints",
    "makespan",
    "total_setup_time",
    "total_tardiness"
  ],
  "budget_scope": "discretionary_experiment_effort_excluding_baseline_and_gates",
  "budget_percent": {
    "auditor": 20,
    "exact_bound": 15,
    "heuristic": 35,
    "realities": 30
  },
  "roles": {
    "or-jssp-lead": {
      "owns": ["assumption_register", "experiment_registry", "budget_ledger"],
      "forbidden": ["invent_objective", "override_validator", "agent_vote"]
    },
    "or-jssp-auditor": {
      "owns": [
        "input_manifest",
        "disjunctive_graph_acyclicity",
        "machine_processing_time_nonnegativity",
        "setup_matrix_integrity",
        "operation_sequence_hash"
      ],
      "forbidden": ["author_solution_numbers", "claim_optimality"]
    },
    "or-jssp-exact-bound": {
      "owns": [
        "exact_lower_bound",
        "cp_sat_gap",
        "taillard_known_optimum_bound",
        "bound_evidence"
      ],
      "forbidden": ["change_processing_time", "claim_unproved_optimum"]
    },
    "or-jssp-heuristic": {
      "owns": [
        "dispatching_rule_incumbent",
        "lns_incumbent",
        "pyjobshop_incumbent",
        "schedule_plan"
      ],
      "forbidden": ["change_precedence", "forge_optimal_status", "claim_heuristic_global_optimum"]
    },
    "or-jssp-realities": {
      "owns": [
        "setup_time_policy",
        "machine_breakdown_calendar",
        "worker_shift_calendar",
        "rolling_horizon_plan",
        "reality_feasibility"
      ],
      "forbidden": [
        "drop_precedence_constraint",
        "hide_overlap",
        "claim_unvalidated_feasibility"
      ]
    },
    "or-jssp-redteam": {
      "owns": ["independent_recompute", "tamper_tests", "claim_audit"],
      "forbidden": ["repair_candidate", "share_solver_state", "waive_failed_gate"]
    }
  },
  "handoff_order": [
    "assumptions",
    "audit",
    "exact_bound",
    "heuristic_search",
    "realities",
    "redteam_validate",
    "write"
  ],
  "experiment_rules": {
    "changed_factors_per_card": 1,
    "seed_required_for_stochastic_search": true,
    "baseline_artifact_required": true,
    "acceptance_criteria_required_before_run": true,
    "failed_experiments_are_retained": true,
    "numbers_may_only_move_via_json_artifacts": true,
    "hard_runtime_cap_required": true,
    "timeout_is_not_no_solution": true,
    "accepted_candidate_requires_independent_validation": true,
    "official_candidate_must_be_lexicographically_nonworse": true,
    "heuristic_status_must_be_feasible": true,
    "forged_optimality_is_forbidden": true
  },
  "candidate_lifecycle": [
    "PROPOSED",
    "SOLVER_FEASIBLE",
    "INDEPENDENTLY_VALIDATED",
    "REDTEAM_PASSED",
    "ACCEPTED"
  ],
  "registry": {
    "budget_ledger": "experiments/scheduling/budget-ledger.json",
    "accepted_solution": "outputs/pyjobshop_jssp-solution.json",
    "validation_report": "outputs/pyjobshop_jssp-validate.json",
    "redteam_report": "outputs/pyjobshop_jssp-redteam.json"
  },
  "stop_rules": {
    "auditor": [
      "freeze_input_manifest_hash_before_search",
      "fail_on_negative_or_missing_processing_time",
      "fail_on_setup_matrix_asymmetry_or_negative_entry",
      "require_disjunctive_graph_acyclicity_before_search"
    ],
    "exact_bound": [
      "report_cp_sat_or_taillard_lower_bound_with_gap",
      "stop_after_time_limit_without_improvement",
      "never_report_a_bound_without_solver_evidence"
    ],
    "heuristic": [
      "stop_after_two_budget_levels_and_three_new_seeds_do_not_improve_makespan",
      "retain_best_feasible_incumbent_within_hard_constraints",
      "never_report_optimal_status_for_heuristic"
    ],
    "realities": [
      "stop_after_breakdown_and_shift_feasibility_converge",
      "report_unmet_realities_explicitly",
      "never_drop_a_precedence_constraint_to_restore_feasibility"
    ]
  },
  "tamper_tests": [
    "machine_overlap_injection",
    "operation_precedence_inversion",
    "setup_time_cheat",
    "makespan_deflation",
    "job_omission_tamper"
  ]
}
