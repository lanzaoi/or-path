# OR-Path relocatable install — optional env (copy ideas into shell; do not commit secrets)

# Install root (defaults to directory of orpath.bat / orpath.sh)
# ORPATH_HOME=D:\apps\orpath

# Case / data directory for notes, outputs, papers (defaults to ORPATH_HOME)
# ORPATH_WORKDIR=E:\cases\demo-run

# Always recommended when running Python tools:
# PYTHONNOUSERSITE=1
